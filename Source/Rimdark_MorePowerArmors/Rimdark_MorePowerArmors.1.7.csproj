<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Rimdark_MorePowerArmors</AssemblyName>
    <RootNamespace>Rimdark_MorePowerArmors</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_7</DefineConstants>
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <DebugType>portable</DebugType>

    <!-- Override either property via -p:RimWorldDir=... -p:WorkshopDir=... when RimWorld is installed elsewhere. -->
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and Exists('C:\Program Files (x86)\Steam\steamapps\common\RimWorld\Assembly-CSharp.dll')">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:\Logiciels\Steam\steamapps\common\RimWorld</RimWorldDir>
    <WorkshopDir Condition="'$(WorkshopDir)' == '' and Exists('C:\Program Files (x86)\Steam\steamapps\workshop\content\294100')">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100</WorkshopDir>
    <WorkshopDir Condition="'$(WorkshopDir)' == ''">C:\Logiciels\Steam\steamapps\workshop\content\294100</WorkshopDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(WorkshopDir)\2009463077\1.7\Assemblies\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Core40k">
      <HintPath>$(WorkshopDir)\3267464767\1.7\Assemblies\Core40k.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Genes40k">
      <HintPath>$(WorkshopDir)\3505068525\1.7\Assemblies\Genes40k.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="OutfitStandGorget.cs" />
    <Compile Include="PawnRenderNode_AttachmentGorget.cs" />
    <Compile Include="Rimdark_MorePowerArmors_Bootstrap.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
</Project>
