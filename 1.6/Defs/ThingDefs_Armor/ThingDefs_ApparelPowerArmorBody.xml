                    <workerClass>Core40k.PawnRenderNodeWorker_AttachmentShoulderPad</workerClass>
                    <nodeClass>Core40k.PawnRenderNode_FlagEdit</nodeClass>
                    <texPath>Things/Armor/Imperium/PowerArmor/MkXPhobosPowerArmor/Shoulder/BEWH_MkXPhobosPowerArmor_Shoulder</texPath>
                    <shaderTypeDef>CutoutComplex</shaderTypeDef>
                    <parentTagDef>Body</parentTagDef>
                    <drawData>
                        <dataEast>
                            <layer>72</layer>
                        </dataEast>
                        <dataWest>
                            <layer>72</layer>
                        </dataWest>
                    </drawData>
                    <texSeed>2</texSeed>
                </li>
            </renderNodeProperties>
        </apparel>
        <comps>
            <li Class="Genes40k.CompProperties_ChapterColorWithShoulderDecoration">
                </li>
            <li Class="Core40k.CompProperties_Decorative">
                <decorativeType>Body</decorativeType>
