    <!-- Terminator Indomitus -->
    <ThingDef ParentName="BEWH_PowerArmorBase">
        <defName>BEWH_IndomitusPowerArmor</defName>
        <label>Indomitus Terminator Power Armor</label>
        <description>The "Indomitus" Terminator Power Armor is a hybrid of Gravis and traditional Tactical Dreadnought designs, created to give Primaris warriors the resilience of Terminator plate while retaining some of the adaptability of Mk X systems. Its bulky ceramite plating and reinforced exo-frame make the wearer almost impervious to small arms fire, though at the cost of speed and flexibility.\n\n This armor can be worn even by a colonist without the Black Carapace gene, but their movement speed will be significantly reduced.</description>
        <recipeMaker>
            <researchPrerequisite>BEWH_PowerArmorMkX</researchPrerequisite>
        </recipeMaker>
        <graphicData>
            <texPath>Things/Armor/Imperium/PowerArmor/IndomitusPowerArmor/BEWH_IndomitusPowerArmor</texPath>
        </graphicData>
        <statBases>
            <WorkToMake>126000</WorkToMake>
            <MarketValue>14000</MarketValue>
            <ArmorRating_Sharp>2.51</ArmorRating_Sharp>
            <ArmorRating_Blunt>1.05</ArmorRating_Blunt>
            <ArmorRating_Heat>1.68</ArmorRating_Heat>
            <Insulation_Cold>56</Insulation_Cold>
            <Insulation_Heat>42</Insulation_Heat>
        </statBases>
        <equippedStatOffsets>
            <TerrorSource MayRequire="Ludeon.RimWorld.Ideology">17</TerrorSource>
            <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.28</VacuumResistance>
            <WorkSpeedGlobal>-0.2</WorkSpeedGlobal>
            <ResearchSpeed>-0.2</ResearchSpeed>
