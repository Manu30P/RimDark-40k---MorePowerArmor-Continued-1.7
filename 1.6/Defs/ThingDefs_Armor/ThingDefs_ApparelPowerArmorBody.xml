                        <dataNorth>
                            <layer>99</layer>
                        </dataNorth>
                        <dataSouth>
                            <layer>-1</layer>
                        </dataSouth>
                    </drawData>
                    <texSeed>1</texSeed>
                </li>
                <!-- Shoulder pad -->
