<Defs>
    <!-- MK 10 Phobos -->
    <ThingDef ParentName="BEWH_PowerArmorBase_ChapterColour">
        <defName>BEWH_MkXPhobosPowerArmor</defName>
        <label>Mk X Phobos Power Armor</label>
        <description>The MK X "Phobos" Power Armor is a lighter-weight ceramite suit and a streamlined design that allow for greater mobility, and its servo-motors are engineered to be completely silent. The design, however, sacrifices protection for stealth and speed.\n\nThis armor can be worn even by a colonist without the Black Carapace gene, but their movement speed will be significantly reduced.</description>
        <recipeMaker>
            <researchPrerequisite>BEWH_PowerArmorMkX</researchPrerequisite>
        </recipeMaker>
        <graphicData>
            <texPath>Things/Armor/Imperium/PowerArmor/MkXPhobosPowerArmor/BEWH_MkXPhobosPowerArmor</texPath>
        </graphicData>
        <statBases>
            <WorkToMake>72000</WorkToMake>
            <MarketValue>8000</MarketValue>
            <ArmorRating_Sharp>1.36</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.59</ArmorRating_Blunt>
            <ArmorRating_Heat>1</ArmorRating_Heat>
            <Insulation_Cold>32</Insulation_Cold>
            <Insulation_Heat>24</Insulation_Heat>
        </statBases>
        <equippedStatOffsets>
            <TerrorSource MayRequire="Ludeon.RimWorld.Ideology">17</TerrorSource>
            <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.28</VacuumResistance>
        </equippedStatOffsets>
        <costList>
            <ComponentSpacer>7</ComponentSpacer>
            <Plasteel>150</Plasteel>
            <Uranium>50</Uranium>
        </costList>
        <apparel>
            <wornGraphicPath>Things/Armor/Imperium/PowerArmor/MkXPhobosPowerArmor/BEWH_MkXPhobosPowerArmor</wornGraphicPath>
            <tags>
                <li>BEWH_PowerArmorMkXPhobos</li>
            </tags>
            <renderNodeProperties>
                <!-- Backpacks -->
