<?xml version='1.0' encoding='UTF-8'?>
<Defs>
    <!-- MK 10 Phobos-->
    <ThingDef ParentName="BEWH_PowerArmorHelmetBase">
        <defName>BEWH_MkXPhobosPowerArmorHelmet</defName>
        <label>Mk X Phobos Power Armor Helmet</label>
        <description>A lightweight helm favored by Phobos-armored Primaris, built for stealth and agility. Its compact sensors, enhanced vox, and low-profile design aid covert strikes and reconnaissance.</description>
        <recipeMaker>
            <researchPrerequisite>BEWH_PowerArmorMkX</researchPrerequisite>
        </recipeMaker>
        <graphicData>
            <texPath>Things/Headgear/Imperium/PowerArmor/MkXPhobosPowerArmorHelmet/BEWH_MkXPhobosHelmet</texPath>
        </graphicData>
        <statBases>
            <WorkToMake>28000</WorkToMake>
            <MarketValue>3200</MarketValue>
            <ArmorRating_Sharp>1.04</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.64</ArmorRating_Blunt>
            <ArmorRating_Heat>0.96</ArmorRating_Heat>
            <Insulation_Cold>5</Insulation_Cold>
            <Insulation_Heat>4</Insulation_Heat>
        </statBases>
        <equippedStatOffsets>
            <TerrorSource MayRequire="Ludeon.RimWorld.Ideology">8</TerrorSource>
            <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.67</VacuumResistance>
            <ShootingAccuracyPawn>2</ShootingAccuracyPawn>
            <MeleeHitChance>2</MeleeHitChance>
            <MeleeDodgeChance>5</MeleeDodgeChance>
        </equippedStatOffsets>
        <costList>
            <ComponentSpacer>2</ComponentSpacer>
            <Plasteel>50</Plasteel>
        </costList>
        <apparel>
            <wornGraphicPath>Things/Headgear/Imperium/PowerArmor/MkXPhobosPowerArmorHelmet/BEWH_MkXPhobosHelmet</wornGraphicPath>
            <tags>
                <li>BEWH_PowerArmorHelmetMkXPhobos</li>
            </tags>
        </apparel>
        <comps>
            <li Class="Genes40k.CompProperties_ChapterColor">
                </li>
            <li Class="Core40k.CompProperties_Decorative">
                <decorativeType>Head</decorativeType>
            </li>
        </comps>
        <modExtensions>
            <li Class="Core40k.DefModExtension_AvailableDrawerTabDefs">
                <tabDefs>
                    <li>BEWH_ArmorColoring</li>
                    <li>BEWH_ArmorDecoration</li>
                </tabDefs>
            </li>
        </modExtensions>
    </ThingDef>
